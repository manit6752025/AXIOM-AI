{
  "name": "axiom-ui",
  "private": true,
  "version": "0.3.0-beta.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gui": "node scripts/start_gui.mjs",
    "build": "node node_modules/@typescript/native/bin/tsc -b && vite build && node scripts/copy_webui.mjs",
    "e2e": "playwright test",
    "lint": "eslint .",
    "preview": "vite preview",
    "prebuild": "node scripts/check_lucide_types.mjs && node scripts/check_typescript_version.mjs",
    "prelint": "node scripts/check_lucide_types.mjs && node scripts/check_typescript_version.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.73.0",
    "vite": "^8.3.8",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
