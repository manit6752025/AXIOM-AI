{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axiom-ai:plugin-manifest:schema:1",
  "title": "AXIOM Declarative Plugin Manifest v1",
  "description": "Metadata-only plugin manifest. It does not define an executable entry point.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema_version",
    "id",
    "name",
    "version",
    "description",
    "tools"
  ],
  "properties": {
    "manifest_schema_version": {
      "const": 1,
      "type": "integer"
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+){1,7}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-([0-9A-Za-z.-]+))?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "scopes"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["read", "write", "execution", "network", "secrets"]
            }
          }
        }
      }
    }
  }
}
